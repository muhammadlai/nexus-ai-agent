{
  "name": "Nexus AI Agent Workflow Template",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "nexus-agent",
        "options": {
          "rawBody": true
        }
      },
      "name": "FastAPI Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "id": "node_webhook_trigger"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "param_event_id",
              "name": "event_id",
              "value": "={{ $json.body.event_id }}",
              "type": "string"
            },
            {
              "id": "param_event_type",
              "name": "event_type",
              "value": "={{ $json.body.event_type }}",
              "type": "string"
            },
            {
              "id": "param_user_id",
              "name": "user_id",
              "value": "={{ $json.body.user_id }}",
              "type": "string"
            }
          ]
        }
      },
      "name": "Extract Event Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "id": "node_extract_data"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:8000/api/v1/webhooks/n8n/callback",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"event_id\": \"{{ $json.event_id }}\",\n  \"event_type\": \"{{ $json.event_type }}\",\n  \"status\": \"success\",\n  \"source\": \"n8n_workflow\",\n  \"processed_by\": \"Nexus AI Agent Workflow\",\n  \"result\": {\n    \"message\": \"Automation task executed successfully via n8n pipeline\",\n    \"processed_at\": \"{{ $now.toISOString() }}\"\n  }\n}"
      },
      "name": "Callback to FastAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        720,
        300
      ],
      "id": "node_http_callback"
    }
  ],
  "connections": {
    "FastAPI Webhook Trigger": {
      "main": [
        [
          {
            "node": "Extract Event Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Event Data": {
      "main": [
        [
          {
            "node": "Callback to FastAPI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {}
}
