# ==========================================
# NEXUS AI AGENT - PRODUCTION ENVIRONMENT CONFIG
# ==========================================

# Server & Project Info
PROJECT_NAME="Nexus AI Agent"
VERSION="1.0.0"
ENVIRONMENT="production"
PORT=3000
SERVER_IP="localhost" # Replace with your Ubuntu VPS Public IP address (e.g. 192.0.2.1) or localhost

# Note: If you acquire a domain name later, update SERVER_IP to your domain (e.g. nexus.yourdomain.com)

# Security & Authentication
JWT_SECRET_KEY="YOUR_SUPER_SECRET_JWT_KEY_REPLACE_IN_PRODUCTION"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Models & Providers
OPENAI_API_KEY="sk-proj-YOUR_OPENAI_API_KEY_HERE"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
DEFAULT_AI_MODEL="gemini-2.5-flash"

# n8n Automation & Webhooks
N8N_WEBHOOK_URL="http://n8n:5678/webhook/nexus-agent"
N8N_WEBHOOK_SECRET="nexus_secret_key_2026"
N8N_ENCRYPTION_KEY="nexus_n8n_encryption_key_change_me"
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER="admin"
N8N_BASIC_AUTH_PASSWORD="nexus_n8n_password_2026"

# Database & Persistent Storage (if external DB added)
POSTGRES_USER="nexus_admin"
POSTGRES_PASSWORD="nexus_postgres_password_2026"
POSTGRES_DB="nexus_db"
